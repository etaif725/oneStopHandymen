# Telegram notifications (optional — lead alerts)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Form Webhook Configuration
# Replace with your actual webhook URL (e.g., Zapier, Make.com, n8n, etc.)
VITE_FORM_WEBHOOK=https://your-webhook-url.com/webhook

# API Key for webhook authentication (optional)
# This will be sent as "x-make-apikey" header with the request
VITE_FORM_API_KEY=your-api-key-here

# Example webhook services:
# - Zapier: https://hooks.zapier.com/hooks/catch/...
# - Make.com (Integromat): https://hook.us1.make.com/...
# - n8n: https://your-n8n-instance.com/webhook/...
# - Custom API: https://api.yourdomain.com/contact
